<aura:component
    implements="force:appHostable,flexipage:availableForAllPageTypes,lightning:isUrlAddressable"
    access="global">

    <aura:attribute name="recordIds" type="String" />
    <aura:attribute name="hasOpened" type="Boolean" default="false"/>
    <aura:attribute name="isClosing" type="Boolean" default="false"/>

    <aura:handler name="change" value="{!v.pageReference}" action="{!c.reInit}"/>
    
    <lightning:overlayLibrary aura:id="overlayLib"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

</aura:component>