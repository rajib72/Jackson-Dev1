<apex:page standardController="WorkOrder" extensions="ServiceEstimationFeedbackController" showHeader="false" sidebar="false" standardStylesheets="false">
    <style>
        :root {
            --primary: #0176d3;
            --success: #2e844a;
            --danger: #ea001e;
            --bg-color: #f4f6f9;
            --card-bg: #ffffff;
            --text-main: #181818;
            --text-muted: #747474;
            --border: #e5e5e5;
        }
        body { font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: var(--bg-color); color: var(--text-main); margin: 0; padding: 30px; }
        .page-container { max-width: 900px; margin: 0 auto; background: var(--card-bg); border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); overflow: hidden; }
        .header { background: linear-gradient(135deg, #0176d3 0%, #014486 100%); color: white; padding: 25px; text-align: center; font-size: 24px; font-weight: 600; }
        
        /* Section Styling */
        .section { padding: 25px 30px; border-bottom: 1px solid var(--border); }
        .section:last-child { border-bottom: none; }
        .section-title { font-size: 18px; color: var(--primary); font-weight: 600; margin-bottom: 15px; display: flex; align-items: center; }
        
        /* Grid Layout for Read-Only Data */
        .data-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .data-item { display: flex; flex-direction: column; }
        .label { font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px; }
        .value { font-size: 15px; font-weight: 500; margin-top: 4px; }
        
        /* Custom Tables */
        .custom-table { width: 100%; border-collapse: collapse; margin-top: 10px; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); }
        .custom-table th { background-color: #f9f9f9; text-align: left; padding: 12px 15px; font-size: 13px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; border-bottom: 2px solid var(--border); }
        .custom-table td { padding: 12px 15px; border-bottom: 1px solid var(--border); font-size: 14px; }
        .custom-table tr:last-child td { border-bottom: none; }
        
        /* Footer and Actions */
        .action-section { background-color: #fafafb; padding: 30px; text-align: center; }
        .prompt-text { font-size: 15px; margin-bottom: 20px; color: #444; line-height: 1.5; }
        .btn { padding: 12px 28px; font-size: 15px; font-weight: 600; border: none; border-radius: 6px; cursor: pointer; transition: all 0.2s ease; color: white; margin: 0 10px; }
        .btn-approve { background-color: var(--success); }
        .btn-approve:hover { background-color: #236c3b; transform: translateY(-2px); }
        .btn-reject { background-color: var(--danger); }
        .btn-reject:hover { background-color: #c20017; transform: translateY(-2px); }
        .btn-submit { background-color: var(--primary); margin-top: 15px; width: 100%; max-width: 300px; }
        .btn-submit:hover { background-color: #015a9f; }
        
        /* Input Fields */
        .remarks-box { margin-top: 25px; text-align: left; animation: fadeIn 0.4s ease-in-out; }
        .input-area { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; resize: vertical; box-sizing: border-box; }
        .input-area:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(1, 118, 211, 0.1); }
        
        .success-msg { text-align: center; padding: 50px; }
        .success-msg h2 { color: var(--success); margin-bottom: 10px; }
        
        @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    </style>

    <div class="page-container">
        <div class="header">Service Estimation Approval</div>
        
        <apex:form id="mainForm">
            <apex:pageMessages />
            
            <apex:outputPanel rendered="{!isSuccess}">
                <div class="success-msg">
                    <h2>✓ Feedback Submitted Successfully</h2>
                    <p>Thank you. Your response has been recorded for Work Order {!woRecord.WorkOrderNumber}.</p>
                </div>
            </apex:outputPanel>

            <apex:outputPanel rendered="{!NOT(isSuccess)}">
                
                <div class="section">
                    <div class="section-title">1. Case Basic Info</div>
                    <div class="data-grid">
                        <div class="data-item"><span class="label">Case Number</span><span class="value">{!woRecord.Case.CaseNumber}</span></div>
                        <div class="data-item"><span class="label">Complaint Type</span><span class="value">{!woRecord.Case.Complaint_Type__c}</span></div>
                        <div class="data-item"><span class="label">Account Name</span><span class="value">{!woRecord.Case.Account.Name}</span></div>
                        <div class="data-item"><span class="label">Contact Name</span><span class="value">{!woRecord.Case.Contact.Name}</span></div>
                        <div class="data-item"><span class="label">Contact Phone</span><span class="value">{!woRecord.Case.ContactPhone}</span></div>
                        <div class="data-item"><span class="label">Contact Email</span><span class="value">{!woRecord.Case.ContactEmail}</span></div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">2. Work Order Details</div>
                    <div class="data-item"><span class="label">Work Order Number</span><span class="value">{!woRecord.WorkOrderNumber}</span></div>
                </div>

                <div class="section">
                    <div class="section-title">3. Item Details With Serial Number</div>
                    <table class="custom-table">
                        <thead><tr><th>Asset Name</th><th>Serial Number</th></tr></thead>
                        <tbody>
                            <apex:repeat value="{!woliList}" var="woli">
                                <tr><td>{!woli.Asset.Name}</td><td>{!woli.Asset_Serial_No__c}</td></tr>
                            </apex:repeat>
                        </tbody>
                    </table>
                </div>

                <div class="section">
                    <div class="section-title">4. Assigned Resource Information</div>
                    <table class="custom-table">
                        <thead><tr><th>Name</th><th>Resource Type</th><th>Phone Number</th><th>Email Id</th></tr></thead>
                        <tbody>
                            <apex:repeat value="{!resourceInfoList}" var="res">
                                <tr>
                                    <td>{!res.resourceName}</td>
                                    <td>{!res.resourceType}</td>
                                    <td>{!res.phone}</td>
                                    <td>{!res.email}</td>
                                </tr>
                            </apex:repeat>
                        </tbody>
                    </table>
                </div>

                <div class="section">
                    <div class="section-title">5. Service Estimation Cost Details</div>
                    <table class="custom-table" style="margin-bottom: 20px;">
                        <thead><tr><th>Description</th><th>Estimated Cost</th></tr></thead>
                        <tbody>
                            <apex:repeat value="{!costDetails}" var="cost">
                                <tr><td>{!cost.Description__c}</td><td>{!cost.Estimated_Cost__c}</td></tr>
                            </apex:repeat>
                        </tbody>
                    </table>
                    
                    <div class="data-item" style="background: #eef4fb; padding: 15px; border-radius: 6px; border-left: 4px solid var(--primary);">
                        <span class="label">Final Service Estimation Cost</span>
                        <span class="value" style="font-size: 18px; color: var(--primary);">${!woRecord.Final_Service_Estimation_Cost__c}</span>
                    </div>
                </div>

                <div class="action-section">
                    <div class="prompt-text">
                        Please review the details above. If everything is accurate, click <strong>Approve</strong>. If not, please click <strong>Reject</strong>.
                    </div>
                    
                    <apex:outputPanel id="actionButtons">
                        <apex:commandButton value="Approve" action="{!selectApprove}" reRender="actionPanel" styleClass="btn btn-approve" rendered="{!NOT(showRemarksBox)}"/>
                        <apex:commandButton value="Reject" action="{!selectReject}" reRender="actionPanel" styleClass="btn btn-reject" rendered="{!NOT(showRemarksBox)}"/>
                    </apex:outputPanel>

                    <apex:outputPanel id="actionPanel">
                        <apex:outputPanel rendered="{!showRemarksBox}" layout="block" styleClass="remarks-box">
                            <div class="data-item">
                                <span class="label" style="color: var(--primary); margin-bottom: 8px;">
                                    You selected: <b>{!feedbackStatus}</b>. Please provide your remarks below: <span style="color:red; font-size:16px;">*</span>
                                </span>
                                <apex:inputTextarea value="{!remarks}" rows="4" styleClass="input-area" html-placeholder="Enter your comments here..."/>
                            </div>
                            <div style="text-align: center;">
                                <apex:commandButton value="Submit Feedback" action="{!saveFeedback}" styleClass="btn btn-submit" reRender="mainForm"/>
                            </div>
                        </apex:outputPanel>
                    </apex:outputPanel>

                </div>
            </apex:outputPanel>
        </apex:form>
    </div>
</apex:page>