<apex:page controller="SRTFeedbackFormPDFController" renderAs="PDF" showHeader="false" sidebar="false" standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false">

    <html>
        <head>
            <style>
                
                @page {
                    size: A4 portrait;
                    margin: 12mm 10mm 14mm 10mm;
                    @bottom-center {
                        content: "Jakson Customer Service  |  Page " counter(page) " of " counter(pages);
                        font-family: Arial, Helvetica, sans-serif;
                        font-size: 8px;
                        color: #5f6b76;
                    }
                }

                * { box-sizing: border-box; }

                body {
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 9px;
                    line-height: 1.25;
                    margin: 0;
                    padding: 0;
                    color: #1f2933;
                    background: #ffffff;
                }
                
                table {
                    width: 100%;
                    border-collapse: collapse;
                    border-spacing: 0;
                    margin: 0 0 7px 0;
                    table-layout: fixed;
                    background: #ffffff;
                    -fs-table-paginate: paginate;
                }
                
                th, td {
                    border: 0.6px solid #9fb3c8;
                    padding: 4px 5px;
                    vertical-align: top;
                    overflow-wrap: break-word;
                }

                tr { page-break-inside: avoid; }
                
                .header {
                    font-size: 17px;
                    line-height: 1.15;
                    font-weight: bold;
                    color: #005b96;
                    text-align: center;
                    letter-spacing: 0.4px;
                }
                
                .subheader {
                    font-size: 8px;
                    color: #4a6c8f;
                    text-align: center;
                    font-weight: normal;
                    letter-spacing: 0;
                }
                
                .section {
                    background: #0b5cad;
                    color: #ffffff;
                    font-weight: bold;
                    font-size: 9px;
                    padding: 5px;
                    text-align: left;
                }
                
                .label { font-weight: bold; color: #005b96; }
                
                .no-border td { border: none; background: #ffffff; }

                .document-header {
                    border-bottom: 2px solid #0b5cad;
                    margin-bottom: 8px;
                }

                .document-header td { vertical-align: middle; padding: 3px 4px 7px 4px; }
                
                label { display: inline-block; margin: 0 7px 2px 0; white-space: nowrap; }

                input[type="checkbox"] {
                    width: 9px;
                    height: 9px;
                    margin: 0 2px 0 0;
                    vertical-align: middle;
                }
                
                .signature { height: 82px; background: #ffffff; line-height: 1.4; }
                
                .footer {
                    text-align: center;
                    color: #0b5cad;
                    font-size: 9px;
                    font-weight: bold;
                    margin-top: 7px;
                }

                
                .keep-together { page-break-inside: avoid; }
                .center { text-align: center; }
                .small { font-size: 8px; }
                .spacer-row td { height: 28px; }
                .remarks-row td { height: 22px; }
                
            </style>
        </head>
        
