<apex:page controller="FeedbackFormPDFController"
    renderAs="pdf"
    contentType="application/pdf#Feedback.pdf">

    <h1 style="text-align:center;">Customer Feedback Report</h1>

    <h2>Case Details</h2>
    <p><b>Case Number:</b> {!caseRec.CaseNumber}</p>

    <h2>Customer Feedback</h2>

    <p><b>Installation Type:</b> {!feedback.Installation_Type__c}</p>
    
    <!-- Show ONLY when Installation Type = Other -->
    <apex:outputPanel rendered="{!AND(feedback.Installation_Type__c == 'Other', NOT(ISBLANK(feedback.Other__c)))}">
        <p><b>Other Installation:</b> {!feedback.Other__c}</p>
    </apex:outputPanel>
    
    <p><b>Name:</b> {!feedback.Please_Enter_Your_Name__c}</p>
    <p><b>State:</b> {!feedback.State__c}</p>
    <p><b>Mobile:</b> {!feedback.Mobile_Number__c}</p>

    <h3>Ratings</h3>

    <p><b>Engineer Help:</b> {!feedback.Did_our_Service_Engineer_help_resolve_yo__c}</p>
    <p><b>Resolution Speed:</b> {!feedback.How_would_you_rate_the_speed_of_issue_re__c}</p>
    <p><b>Recommendation:</b> {!feedback.How_likely_are_you_to_recommend_us_to_a__c}</p>

    <h3>Suggestions</h3>
    <p>{!feedback.How_can_we_enhance_our_product_or_servic__c}</p>

</apex:page>