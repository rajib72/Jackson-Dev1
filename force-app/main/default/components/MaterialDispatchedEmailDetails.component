<apex:component controller="MaterialDispatchedEmailController"
    access="global">

    <apex:attribute name="workOrderRecordId"
        type="Id"
        assignTo="{!workOrderId}"
        description="Work Order ID"/>

    <apex:outputPanel rendered="{!NOT(hasError)}">

        <p>
            <strong>Case Number:</strong>
            <apex:outputText value="{!caseNumber}"/>
            <br/>

            <strong>Work Order Number:</strong>
            <apex:outputText value="{!workOrderNumber}"/>
            <br/>

            <strong>Product Request Number:</strong>
            <apex:outputText value="{!productRequestNumber}"/>
            <br/>

            <strong>Dispatch Date:</strong>
            <apex:outputText value="{0,date,dd-MM-yyyy}">
                <apex:param value="{!dispatchDate}"/>
            </apex:outputText>
            <br/>

            <strong>Material Details:</strong>
            <apex:outputText value="{!materialDetails}"/>
            <br/>

            <strong>Quantity:</strong>
            <apex:outputText value="{!materialQuantity}"/>
            <br/>

            <strong>Transporter:</strong>
            <apex:outputText value="{!courierName}"/>
            <br/>

            <strong>Tracking Number:</strong>
            <apex:outputText value="{!trackingNumber}"/>
            <br/>

            <strong>Expected Delivery Date:</strong>
            <apex:outputText value="{0,date,dd-MM-yyyy}">
                <apex:param value="{!expectedDeliveryDate}"/>
            </apex:outputText>
        </p>

    </apex:outputPanel>

    <!-- Remove after successful testing -->
    <apex:outputPanel rendered="{!hasError}">
        <p style="color:red;">
            <strong>
                <apex:outputText value="{!errorMessage}"/>
            </strong>
        </p>
    </apex:outputPanel>

</apex:component>