<apex:component controller="ResolutionDecisionEmailController"
    access="global">

    <apex:attribute name="workOrderRecordId"
        type="Id"
        assignTo="{!workOrderId}"
        description="Work Order Id"/>

    <apex:outputPanel rendered="{!NOT(hasError)}">
        <p>
            <strong>Case Number:</strong>
            <apex:outputText value="{!caseNumber}"/>
            <br/>

            <strong>Work Order Number:</strong>
            <apex:outputText value="{!workOrderNumber}"/>
            <br/>

            <strong>Decision Date:</strong>
            <apex:outputText value="{0,date,dd-MM-yyyy}">
                <apex:param value="{!decisionDate}"/>
            </apex:outputText>
            <br/>

            <strong>Resolution Type:</strong>
            <apex:outputText value="{!containmentAction}"/>
        </p>
    </apex:outputPanel>

    <!-- Keep this temporarily for testing -->
    <apex:outputPanel rendered="{!hasError}">
        <p style="color:red;">
            <strong>{!errorMessage}</strong>
        </p>
    </apex:outputPanel>

</apex:component>