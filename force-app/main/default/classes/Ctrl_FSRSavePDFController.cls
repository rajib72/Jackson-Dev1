public with sharing class Ctrl_FSRSavePDFController {

    public Id fsrId { get; set; }
    public Field_Service_Report_FSR__c fsr { get; set; }

    public Ctrl_FSRSavePDFController(
        ApexPages.StandardController stdController
    ) {

        this.fsrId = stdController.getId();

        if (this.fsrId != null) {

            this.fsr = [
                SELECT
                    Id,
                    Name,
                    FSR_No__c
                FROM Field_Service_Report_FSR__c
                WHERE Id = :fsrId
                LIMIT 1
            ];
        }
    }


    public PageReference generateAndSavePDF() {

        if (this.fsrId == null) {
            return null;
        }


        // =========================================================
        // 1. Reference the actual FSR PDF Visualforce page
        // =========================================================

        PageReference pdfPage =
            new PageReference('/apex/VF_FsrReportPDF');

        pdfPage.getParameters().put(
            'id',
            this.fsrId
        );


        // =========================================================
        // 2. Generate PDF Blob
        // =========================================================

        Blob pdfBlob;

        if (Test.isRunningTest()) {

            pdfBlob = Blob.valueOf(
                'Test PDF Content'
            );

        } else {

            pdfBlob = pdfPage.getContent();

        }


        // =========================================================
        // 3. Generate File Name
        // =========================================================

        String safeName = 'FSR';

        if (fsr.FSR_No__c != null) {

            safeName = String.valueOf(
                fsr.FSR_No__c
            ).replaceAll(
                '\\s+',
                '_'
            );
        }
        else if (fsr.Name != null) {

            safeName = String.valueOf(
                fsr.Name
            ).replaceAll(
                '\\s+',
                '_'
            );
        }


        String fileName =
            'Field_Service_Report_' +
            safeName +
            '.pdf';


        // =========================================================
        // 4. Create Salesforce File
        // =========================================================

        ContentVersion cv =
            new ContentVersion();

        cv.Title = fileName;
        cv.PathOnClient = fileName;
        cv.VersionData = pdfBlob;
        cv.Origin = 'H';
        cv.ContentLocation = 'S';

        insert cv;


        // =========================================================
        // 5. Get ContentDocumentId
        // =========================================================

        Id contentDocumentId = [
            SELECT ContentDocumentId
            FROM ContentVersion
            WHERE Id = :cv.Id
            LIMIT 1
        ].ContentDocumentId;


        // =========================================================
        // 6. Link File to FSR Record
        // =========================================================

        ContentDocumentLink cdl =
            new ContentDocumentLink();

        cdl.ContentDocumentId =
            contentDocumentId;

        cdl.LinkedEntityId =
            this.fsrId;

        cdl.ShareType = 'I';
        cdl.Visibility = 'AllUsers';

        insert cdl;


        // =========================================================
        // 7. Redirect back to FSR record
        // =========================================================

        PageReference recordPage =
            new ApexPages.StandardController(
                fsr
            ).view();

        recordPage.setRedirect(true);

        return recordPage;
    }
    
