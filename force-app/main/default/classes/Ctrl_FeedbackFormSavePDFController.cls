public with sharing class Ctrl_FeedbackFormSavePDFController {

    private Id feedbackFormId;
    private Feedback_Form__c feedbackForm;

    public Ctrl_FeedbackFormSavePDFController(
        ApexPages.StandardController stdController
    ) {

        this.feedbackFormId = stdController.getId();

        if (this.feedbackFormId != null) {

            this.feedbackForm = [
                SELECT
                    Id,
                    Name,
                    Case__c,
                    Case__r.CaseNumber
                FROM Feedback_Form__c
                WHERE Id = :feedbackFormId
                LIMIT 1
            ];
        }
    }


    public PageReference generateAndSavePDF() {

        if (this.feedbackFormId == null) {
            return null;
        }


        /* =========================================================
           1. Create reference to the PDF VF page
        ========================================================== */

        PageReference pdfPage =
            new PageReference(
                '/apex/vf_Feedback_Form_PDF'
            );

        pdfPage.getParameters().put(
            'id',
            this.feedbackFormId
        );


        /* =========================================================
           2. Generate PDF Blob
        ========================================================== */

        Blob pdfBlob;

        if (Test.isRunningTest()) {

            pdfBlob = Blob.valueOf(
                'Test PDF Content'
            );

        } else {

            pdfBlob = pdfPage.getContent();

        }


        /* =========================================================
           3. Generate File Name
        ========================================================== */

        String baseName = 'Customer_Feedback';

        if (feedbackForm.Case__r != null &&
            feedbackForm.Case__r.CaseNumber != null) {

            baseName += '_' +
                feedbackForm.Case__r.CaseNumber;
        }

        String fileName =
            baseName + '.pdf';


        /* =========================================================
           4. Create Salesforce File
        ========================================================== */

        ContentVersion cv = new ContentVersion();

        cv.Title = fileName;
        cv.PathOnClient = fileName;
        cv.VersionData = pdfBlob;
        cv.Origin = 'H';
        cv.ContentLocation = 'S';

        insert cv;


        /* =========================================================
           5. Get ContentDocumentId
        ========================================================== */

        Id contentDocumentId = [
            SELECT ContentDocumentId
            FROM ContentVersion
            WHERE Id = :cv.Id
            LIMIT 1
        ].ContentDocumentId;


        /* =========================================================
           6. Link File to Feedback_Form__c
        ========================================================== */

        ContentDocumentLink cdl =
            new ContentDocumentLink();

        cdl.ContentDocumentId =
            contentDocumentId;

        cdl.LinkedEntityId =
            this.feedbackFormId;

        cdl.ShareType = 'I';

        cdl.Visibility = 'AllUsers';

        insert cdl;


        /* =========================================================
           7. Redirect back to Feedback Form record
        ========================================================== */

        PageReference recordPage =
            new ApexPages.StandardController(
                feedbackForm
            ).view();

        recordPage.setRedirect(true);

        return recordPage;
    }
    
