public without sharing class ctrl_SendFSRReportEmail {

    /*
     * ============================================================
     * INVOCABLE REQUEST
     * ============================================================
     */
    public class Request {

        @InvocableVariable(
            label='Case Id'
            description='Case Id from the Feedback Form'
            required=true
        )
        public Id caseId;

        public Request() {
        }
    }


    /*
     * ============================================================
     * FLOW ENTRY POINT
     * ============================================================
     */
    @InvocableMethod(
        label='Send FSR Report Email'
        description='Schedules the FSR email to run asynchronously'
    )
    public static void sendFSRReportEmail(List<Request> requests) {

        if (requests == null || requests.isEmpty()) {
            return;
        }

        Set<Id> caseIds = new Set<Id>();

        for (Request request : requests) {

            if (request != null && request.caseId != null) {
                caseIds.add(request.caseId);
            }
        }

        if (caseIds.isEmpty()) {
            return;
        }

        /*
         * --------------------------------------------------------
         * Move the actual processing to a separate transaction.
         * --------------------------------------------------------
         */
        sendFSRReportEmailFuture(
            new List<Id>(caseIds)
        );
    }


    /*
     * ============================================================
     * FUTURE METHOD
     * ============================================================
     */
    @future
    private static void sendFSRReportEmailFuture(List<Id> caseIds) {

        if (caseIds == null || caseIds.isEmpty()) {
            return;
        }


        /*
         * ========================================================
         * 1. GET LATEST WORK ORDER FOR EACH CASE
         * ========================================================
         */

        Map<Id, WorkOrder> latestWorkOrderByCaseId =
            new Map<Id, WorkOrder>();

        for (WorkOrder wo : [
            SELECT Id,
                   CaseId,
                   ContactId,
                   CreatedDate
            FROM WorkOrder
            WHERE CaseId IN :caseIds
            WITH SYSTEM_MODE
            ORDER BY CreatedDate DESC
        ]) {

            if (
                wo.CaseId != null &&
                !latestWorkOrderByCaseId.containsKey(wo.CaseId)
            ) {
                latestWorkOrderByCaseId.put(
                    wo.CaseId,
                    wo
                );
            }
        }


        /*
         * ========================================================
         * 2. GET LATEST FSR FOR EACH WORK ORDER
         * ========================================================
         */

        Set<Id> workOrderIds =
            new Set<Id>(
                new Map<Id, WorkOrder>(
                    latestWorkOrderByCaseId.values()
                ).keySet()
            );

        /*
         * The above Map key is WorkOrder Id.
         * If no Work Orders exist, stop.
         */
        if (workOrderIds.isEmpty()) {
            System.debug(
                LoggingLevel.ERROR,
                'FSR Email: No Work Orders found.'
            );
            return;
        }


        Map<Id, Field_Service_Report_FSR__c>
            latestFSRByWorkOrderId =
            new Map<Id, Field_Service_Report_FSR__c>();

        for (Field_Service_Report_FSR__c fsr : [
            SELECT Id,
                   Name,
                   Work_Order__c,
                   CreatedDate
            FROM Field_Service_Report_FSR__c
            WHERE Work_Order__c IN :workOrderIds
            WITH SYSTEM_MODE
            ORDER BY CreatedDate DESC
        ]) {

            if (
                fsr.Work_Order__c != null &&
                !latestFSRByWorkOrderId.containsKey(
                    fsr.Work_Order__c
                )
            ) {
                latestFSRByWorkOrderId.put(
                    fsr.Work_Order__c,
                    fsr
                );
            }
        }


        if (latestFSRByWorkOrderId.isEmpty()) {
            System.debug(
                LoggingLevel.ERROR,
                'FSR Email: No FSR found.'
            );
            return;
        }


        /*
         * ========================================================
         * 3. GET CONTENT DOCUMENT LINKS
         *
         * This is the part currently failing in the Guest context.
         * ========================================================
         */

        Set<Id> fsrIds =
            new Set<Id>();

        for (
            Field_Service_Report_FSR__c fsr :
            latestFSRByWorkOrderId.values()
        ) {
            fsrIds.add(fsr.Id);
        }


        Map<Id, ContentDocumentLink>
            latestFileLinkByFSRId =
            new Map<Id, ContentDocumentLink>();

        for (ContentDocumentLink link : [
            SELECT Id,
                   LinkedEntityId,
                   ContentDocumentId,
                   ShareType,
                   Visibility,
                   SystemModstamp
            FROM ContentDocumentLink
            WHERE LinkedEntityId IN :fsrIds
            WITH SYSTEM_MODE
            ORDER BY SystemModstamp DESC
        ]) {

            if (
                link.LinkedEntityId != null &&
                !latestFileLinkByFSRId.containsKey(
                    link.LinkedEntityId
                )
            ) {
                latestFileLinkByFSRId.put(
                    link.LinkedEntityId,
                    link
                );
            }
        }


        /*
         * DEBUG: This is the exact area we are testing.
         */
        System.debug(
            LoggingLevel.ERROR,
            'FSR Email: FSR IDs = ' + fsrIds
        );

        System.debug(
            LoggingLevel.ERROR,
            'FSR Email: File links found = ' +
            latestFileLinkByFSRId.size()
        );


        if (latestFileLinkByFSRId.isEmpty()) {

            System.debug(
                LoggingLevel.ERROR,
                'FSR Email: No Salesforce File is attached to the FSR.'
            );

            return;
        }


        /*
         * ========================================================
         * 4. GET LATEST CONTENT VERSION
         * ========================================================
         */

        Set<Id> contentDocumentIds =
            new Set<Id>();

        for (
            ContentDocumentLink link :
            latestFileLinkByFSRId.values()
        ) {
            contentDocumentIds.add(
                link.ContentDocumentId
            );
        }


        Map<Id, ContentVersion>
            latestContentVersionByDocumentId =
            new Map<Id, ContentVersion>();

        for (ContentVersion cv : [
            SELECT Id,
                   ContentDocumentId,
                   Title,
                   FileExtension,
                   ContentSize,
                   IsLatest,
                   IsMajorVersion,
                   PublishStatus
            FROM ContentVersion
            WHERE ContentDocumentId IN :contentDocumentIds
            AND IsLatest = true
            WITH SYSTEM_MODE
        ]) {

            latestContentVersionByDocumentId.put(
                cv.ContentDocumentId,
                cv
            );
        }


        /*
         * ========================================================
         * 5. GET EMAIL TEMPLATE
         * ========================================================
         */

        EmailTemplate emailTemplate = [
            SELECT Id,
                   DeveloperName,
                   Name
            FROM EmailTemplate
            WHERE DeveloperName =
                'FSR_REPORT_SEND_AFTER_FEEDBACK'
            WITH SYSTEM_MODE
            LIMIT 1
        ];


        /*
         * ========================================================
         * 6. GET ORG-WIDE EMAIL ADDRESS
         * ========================================================
         */

        OrgWideEmailAddress orgWideEmail = [
            SELECT Id,
                   Address,
                   DisplayName
            FROM OrgWideEmailAddress
            WHERE Address = 'crm@jakson.com'
            WITH SYSTEM_MODE
            LIMIT 1
        ];


        /*
         * ========================================================
         * 7. CREATE EMAILS
         * ========================================================
         */

        List<Messaging.SingleEmailMessage> emails =
            new List<Messaging.SingleEmailMessage>();


        for (Id caseId : caseIds) {

            WorkOrder workOrder =
                latestWorkOrderByCaseId.get(caseId);

            if (workOrder == null) {
                continue;
            }


            if (workOrder.ContactId == null) {

                System.debug(
                    LoggingLevel.ERROR,
                    'FSR Email: Work Order has no Contact. ' +
                    workOrder.Id
                );

                continue;
            }


            Field_Service_Report_FSR__c fsr =
                latestFSRByWorkOrderId.get(
                    workOrder.Id
                );

            if (fsr == null) {
                continue;
            }


            ContentDocumentLink fileLink =
                latestFileLinkByFSRId.get(
                    fsr.Id
                );

            if (fileLink == null) {
                continue;
            }


            ContentVersion cv =
                latestContentVersionByDocumentId.get(
                    fileLink.ContentDocumentId
                );

            if (cv == null) {

                System.debug(
                    LoggingLevel.ERROR,
                    'FSR Email: No latest ContentVersion found. ' +
                    fsr.Id
                );

                continue;
            }


            /*
             * ----------------------------------------------------
             * Validate file
             * ----------------------------------------------------
             */

            if (
                cv.FileExtension == null ||
                cv.FileExtension.toLowerCase() != 'pdf'
            ) {

                System.debug(
                    LoggingLevel.ERROR,
                    'FSR Email: File is not PDF. ' +
                    cv.Title
                );

                continue;
            }


            /*
             * ----------------------------------------------------
             * CREATE EMAIL
             * ----------------------------------------------------
             */

            Messaging.SingleEmailMessage email =
                new Messaging.SingleEmailMessage();


            /*
             * Recipient = Work Order Contact
             */
            email.setTargetObjectId(
                workOrder.ContactId
            );


            /*
             * Existing Email Template
             */
            email.setTemplateId(
                emailTemplate.Id
            );


            /*
             * Existing sender
             */
            email.setOrgWideEmailAddressId(
                orgWideEmail.Id
            );


            /*
             * ====================================================
             * ATTACH FSR PDF
             * ====================================================
             */
            email.setEntityAttachments(
                new List<Id>{
                    cv.Id
                }
            );


            /*
             * Log email on Contact
             */
            email.setSaveAsActivity(true);


            emails.add(email);
        }


        /*
         * ========================================================
         * 8. SEND EMAIL
         * ========================================================
         */

        if (emails.isEmpty()) {
            return;
        }


        Messaging.SendEmailResult[] results =
            Messaging.sendEmail(
                emails,
                false
            );


        /*
         * ========================================================
         * 9. DEBUG RESULTS
         * ========================================================
         */

        for (
            Messaging.SendEmailResult result :
            results
        ) {

            System.debug(
                LoggingLevel.ERROR,
                'FSR Email Send Success = ' +
                result.isSuccess()
            );


            if (!result.isSuccess()) {

                for (
                    Messaging.SendEmailError error :
                    result.getErrors()
                ) {

                    System.debug(
                        LoggingLevel.ERROR,
                        'FSR Email Error Code = ' +
                        error.getStatusCode()
                    );

                    System.debug(
                        LoggingLevel.ERROR,
                        'FSR Email Error Message = ' +
                        error.getMessage()
                    );
                }
            }
        }
    }    
