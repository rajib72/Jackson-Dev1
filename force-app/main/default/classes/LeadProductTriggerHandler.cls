public with sharing class LeadProductTriggerHandler {

    public static void updateLeadExpectedCapacity(
        List<Lead_Product__c> newList,
        List<Lead_Product__c> oldList
    ) {
        Set<Id> leadIds = new Set<Id>();

        if (newList != null) {
            for (Lead_Product__c lp : newList) {
                if (lp.Lead__c != null) {
                    leadIds.add(lp.Lead__c);
                }
            }
        }

        if (oldList != null) {
            for (Lead_Product__c lp : oldList) {
                if (lp.Lead__c != null) {
                    leadIds.add(lp.Lead__c);
                }
            }
        }

        if (leadIds.isEmpty()) {
            return;
        }

        /*
         * Only Solar Sales Lead will be processed
         */
        Map<Id, Lead> solarSalesLeadMap = new Map<Id, Lead>([
            SELECT Id,
                   Internal_Business_Team__c,
                   Expected_Capacity__c,
                   UOM__c
            FROM Lead
            WHERE Id IN :leadIds
            AND Internal_Business_Team__c = 'Solar Sales'
        ]);

        if (solarSalesLeadMap.isEmpty()) {
            return;
        }

        Set<Id> solarSalesLeadIds = solarSalesLeadMap.keySet();

        Map<Id, Decimal> leadIdToCapacityKW = new Map<Id, Decimal>();

        for (Id leadId : solarSalesLeadIds) {
            leadIdToCapacityKW.put(leadId, 0);
        }

        List<Lead_Product__c> leadProducts = [
            SELECT Id,
                   Lead__c,
                   Project_Capacity__c,
                   UOM__c
            FROM Lead_Product__c
            WHERE Lead__c IN :solarSalesLeadIds
        ];

        for (Lead_Product__c lp : leadProducts) {
            if (lp.Lead__c == null || lp.Project_Capacity__c == null) {
                continue;
            }

            Decimal capacityInKW = convertToKW(lp.Project_Capacity__c, lp.UOM__c);

            Decimal existingValue = leadIdToCapacityKW.containsKey(lp.Lead__c)
                ? leadIdToCapacityKW.get(lp.Lead__c)
                : 0;

            leadIdToCapacityKW.put(lp.Lead__c, existingValue + capacityInKW);
        }

        List<Lead> leadsToUpdate = new List<Lead>();

        for (Id leadId : solarSalesLeadIds) {
            Decimal totalCapacityKW = leadIdToCapacityKW.get(leadId);

            Lead existingLead = solarSalesLeadMap.get(leadId);

            if (
                existingLead.Expected_Capacity__c != totalCapacityKW ||
                existingLead.UOM__c != 'KW'
            ) {
                leadsToUpdate.add(new Lead(
                    Id = leadId,
                    Expected_Capacity__c = totalCapacityKW,
                    UOM__c = 'KW'
                ));
            }
        }

        if (!leadsToUpdate.isEmpty()) {
            update leadsToUpdate;
        }
    }

    private static Decimal convertToKW(Decimal capacity, String uom) {
        if (capacity == null) {
            return 0;
        }

        if (String.isBlank(uom)) {
            return capacity;
        }

        String normalizedUom = uom.trim().toUpperCase();

        if (normalizedUom == 'MW') {
            return capacity * 1000;
        }

        if (normalizedUom == 'KW') {
            return capacity;
        }

        return capacity;
    }
